{
  "name": "velara",
  "description": "A full-stack movie tracker app",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "author": "carlba",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "start:dev": "concurrently \"npm --workspace packages/backend run start:dev\" \"npm --workspace packages/frontend run start:dev\"",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.3"
  }
}
