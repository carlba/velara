{
  "name": "velara-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "author": "carlba",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists='.env' dist/index.js",
    "start:dev": "tsx --env-file-if-exists=.env --watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:dump": "mkdir -p ./db && docker compose -f ../../docker-compose.yml exec -T postgres sh -c 'pg_dump --no-owner --no-privileges --dbname=\"postgresql://velara:velara@postgres:5432/velara\"' > ./db/velara.sql",
    "db:restore": "docker compose -f ../../docker-compose.yml exec -T postgres psql --dbname=\"postgresql://velara:velara@postgres:5432/velara\" < ./db/velara.sql",
    "db:truncate-except-users": "echo 'TRUNCATE TABLE \"Review\", \"WatchEntry\", \"WatchHistory\", \"Rating\", \"Comment\", \"TvWatchEntry\", \"TvWatchHistory\", \"TvRating\", \"TvReview\", \"TvComment\" RESTART IDENTITY CASCADE;' | prisma db execute --stdin --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/tough-cookie": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "prettier": "^3.8.3",
    "prisma": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^6.2.1",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "got": "^14.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tough-cookie": "^4.0.0",
    "zod": "^4.3.6"
  }
}
